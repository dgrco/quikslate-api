erDiagram
    USER {
      uuid id PK
      string email
      string name
      string password_hash
      timestamp created_at
    }
    BUSINESS {
      uuid id PK
      string name
      timestamp created_at
    }
    BUSINESS_MEMBER {
      uuid user_id FK
      uuid business_id FK
      bool is_admin
    }
    LOCATION {
      uuid id PK
      uuid business_id FK
      string name
    }
    LOCATION_ROLE {
      uuid user_id FK
      uuid business_id FK
      uuid location_id FK
      string role "manager or employee"
    }
    POSITION {
      uuid id PK
      uuid business_id FK
      string name
    }
    EMPLOYEE_POSITION {
      uuid user_id FK
      uuid position_id FK
    }
    SHIFT {
      uuid id PK
      uuid location_id FK
      uuid assigned_user_id FK
      uuid position_id FK
      timestamp start_time
      timestamp end_time
      bool published
    }
    REFRESH_TOKEN {
      string token PK
      uuid user_id FK
      uuid business_id FK
      uuid location_id FK
      timestamp expires_at
    }

    USER ||--o{ BUSINESS_MEMBER : "member of"
    BUSINESS ||--o{ BUSINESS_MEMBER : "has members"
    BUSINESS ||--o{ LOCATION : "has"
    BUSINESS ||--o{ POSITION : "defines"
    USER ||--o{ LOCATION_ROLE : "assigned"
    LOCATION ||--o{ LOCATION_ROLE : "scopes"
    USER ||--o{ EMPLOYEE_POSITION : "qualifies for"
    POSITION ||--o{ EMPLOYEE_POSITION : "held by"
    LOCATION ||--o{ SHIFT : "hosts"
    USER ||--o{ SHIFT : "works"
    POSITION ||--o{ SHIFT : "categorises"
    USER ||--o{ REFRESH_TOKEN : "holds"
