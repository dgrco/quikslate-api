# Copy to .env and fill in. That one file holds everything; docker-compose.yml
# reads it automatically and its environment: blocks decide which service sees
# which value.
# Generate secrets with: openssl rand -hex 32

# Database passwords. The postgres image and initdb/01-roles.sh read these only
# on first boot, while the postgres_data volume is still empty. Changing one
# later has no effect until the volume is recreated.
# Keep them alphanumeric: they are substituted into a URL, so characters like
# @ : / ? # would need percent-encoding to survive parsing.
POSTGRES_PASSWORD=
MIGRATE_PASSWORD=
API_PASSWORD=

# API config. SECURE_MODE=false and the sslmode=disable in the URLs below are
# development settings; both flip before this is reachable from the internet.
JWT_SECRET=
API_PORT=8080
SECURE_MODE=false
CORS_ORIGINS=http://localhost:5173
MAILER=log
FRONTEND_BASE_URL=

# Host-only. Used when running `go run ./cmd/...` outside Docker, where the
# database is on localhost rather than the compose hostname. .env never reaches
# an image, so inside a container this line is absent and the value from
# compose applies instead.
# This uses the migrate role so host-side migrations work. The api/migrate
# privilege split is enforced in the containers, which is what production runs.
DATABASE_URL=postgres://quikslate_migrate:<MIGRATE_PASSWORD>@localhost:5432/quikslate?sslmode=disable
