flowchart TD
    A(["POST /auth/login\n{ email, password }"])
    B{"User exists &\npassword valid?"}
    C["❌ 401 Unauthorized"]
    D{"How many business\nmemberships?"}
    E["❌ 401 — No memberships"]
    F["Return business list\nRequiresBusinessSelection: true\n+ userId"]
    G(["POST /auth/select-business\n{ userId, businessId }"])
    H{"Verify BusinessMember\n+ get LocationRoles"}
    I["❌ 401"]
    J{"How many\nlocation roles?"}
    K["🎟 Issue admin-only token\nlocationId='', role=''"]
    L["Return location list\nRequiresLocationSelection: true"]
    M(["POST /auth/select-location\n{ userId, businessId, locationId }"])
    N{"Verify membership\n+ LocationRole"}
    O["❌ 401"]
    P["🎟 Issue full token\nwith locationId + role"]
    Q["✅ Access Token in body\n+ Refresh Token in HttpOnly cookie"]

    A --> B
    B -->|No| C
    B -->|Yes| D
    D -->|0| E
    D -->|multiple| F --> G
    D -->|1 — auto-proceed| G
    G --> H
    H -->|not a member| I
    H -->|ok| J
    J -->|"0 roles\n+ isAdmin=true"| K --> Q
    J -->|1 role| P --> Q
    J -->|multiple roles| L --> M
    M --> N
    N -->|invalid| O
    N -->|ok| P
